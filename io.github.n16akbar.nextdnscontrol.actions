[io.github.n16akbar.nextdnscontrol.setmode]
Name=Change DNS mode
Description=Authentication is required to switch between NextDNS and the default network DNS
Policy=auth_admin

[io.github.n16akbar.nextdnscontrol.setprofile]
Name=Change NextDNS profile
Description=Authentication is required to change the NextDNS profile ID
Policy=auth_admin
